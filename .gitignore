# Submission allowlist for CO3117 Machine Learning assignment
#
# The assignment requires a runnable Colab front-end and a clear package with
# notebooks/, modules/, reports/, and features/. Ignore everything by default,
# then keep only the files needed to run or submit the project.

/*

# Root files required for GitHub/Colab
!/.gitignore
!/README.md
!/requirements.txt

# Runtime configuration used by the main notebook
!/configs/
/configs/*
!/configs/model_experiments.json
!/configs/deep_learning_experiments.json

# Public dataset mirrored here because the Colab bootstrap downloads this exact
# GitHub raw URL when the local copy is absent.
!/data/
/data/*
!/data/aug_train.csv

# Extracted features required by the assignment
!/features/
/features/*
!/features/*.npy
!/features/*.h5

# Python modules imported by notebooks/ML_Tabular_Final.ipynb
!/modules/
/modules/*
!/modules/__init__.py
!/modules/eda_viz.py
!/modules/preprocessing.py
!/modules/modeling.py
!/modules/deep_learning.py

# The single Colab front-end required for submission
!/notebooks/
/notebooks/*
!/notebooks/ML_Tabular_Final.ipynb

# Keep only the current final report. Report source, generators, intermediate
# CSV/figures, and previous report builds remain local and are not committed.
!/reports/
/reports/*
!/reports/G3-Report.pdf

# Local caches and editor/environment state (also applies inside allowed dirs)
**/__pycache__/
*.py[codz]
*.so
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.env.*
.venv/
venv/
env/
.idea/
.vscode/
*.log
*.tmp
*.swp
*~

# LaTeX/report build intermediates
*.aux
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc
*.tex
