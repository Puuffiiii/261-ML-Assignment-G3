{
  "random_state": 42,
  "n_jobs": -1,
  "selection_metric": "validation_pr_auc",
  "models": {
    "logistic_regression": {
      "representations": ["std", "pca90", "pca95"],
      "parameter_grid": [
        {"C": 0.1, "class_weight": null},
        {"C": 1.0, "class_weight": null},
        {"C": 10.0, "class_weight": null},
        {"C": 0.1, "class_weight": "balanced"},
        {"C": 1.0, "class_weight": "balanced"},
        {"C": 10.0, "class_weight": "balanced"}
      ]
    },
    "random_forest": {
      "representations": ["std", "pca95"],
      "parameter_grid": [
        {
          "n_estimators": 250,
          "max_depth": 8,
          "min_samples_leaf": 2,
          "max_features": "sqrt",
          "class_weight": "balanced"
        },
        {
          "n_estimators": 300,
          "max_depth": 12,
          "min_samples_leaf": 3,
          "max_features": "sqrt",
          "class_weight": "balanced_subsample"
        },
        {
          "n_estimators": 300,
          "max_depth": null,
          "min_samples_leaf": 5,
          "max_features": 0.7,
          "class_weight": "balanced_subsample"
        }
      ]
    }
  }
}
